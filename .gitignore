.DS_Store
*.zip
node_modules/
.env
package.json
package-lock.json
.claude/
test-results/
playwright-report/
settings.local.json
tests/flow/.local-accounts.json

# Local screenshot scratch (never repo content)
_shot_*.png
# Every local screenshot from tests/shot-*.spec.js, whatever it is named.
*-mobile.png
*-320.png
week-rail-*.png
week-bars-*.png
# The drill and Team shots, added 2026-08-30. These were being COMMITTED,
# because the patterns above were written per-filename and never extended when
# tests/shot-week-bars.spec.js grew new outputs. A prefix rule per shot family
# so the next one added is covered without anyone remembering this file exists.
drill-*.png
team-*.png
afford-*.png
skel-*.png
month-one-week.png
zz-*.png

# native/ is a real npm package the iOS build needs; the blanket package.json
# ignore above predates it and silently dropped it from the first workflow PR.
#
# The wildcard is deliberate. This used to be one line per plugin, and build 19
# proved why that is a trap: six new plugins were added, nobody remembered to
# add six more lines, and their package.json files were silently never
# committed. Capacitor then found 6 plugins instead of 12 and the build shipped
# without them. One pattern covers every plugin ever added.
!native/package.json
!native/*/package.json
tests/flow/.local-crew.json
tests/flow/.local-showcase.json
tests/flow/.local-showcase-messy.json
local-visual-shots/

# Python bytecode. py_compile drops these next to any script it checks, and
# they got committed once already by a git add -A.
__pycache__/
*.pyc
