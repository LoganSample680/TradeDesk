    "fixtures[*].dfu.private and .public: drainage fixture units per fixture (UPC)",
    "fixtures[*].trapSizeIn: minimum trap size per fixture",
    "fixtures[*].wsfu.private/.public .cold/.hot/.total: water supply fixture units per fixture",
    "dfu.continuousFlowDfuPerGpm: fixture units per gpm of continuous flow",
    "dfu.unlistedByTrapSizeIn[]: fixture units for an unlisted fixture, by trap size",
    "drain.minSizeIn, drain.minSizeForWaterClosetIn, drain.defaultSlopeInPerFt, drain.slopesInPerFt",
    "drain.horizontalBranch[]: rows of {sizeIn, maxDfu}",
    "drain.stack[]: rows of {sizeIn, maxDfuTotal, maxDfuPerBranchInterval, maxBranchIntervals}",
    "drain.buildingDrain[]: rows of {sizeIn, maxDfuBySlope}",
    "vent.minSizeIn, vent.minFractionOfDrainSize",
    "vent.table[]: rows of {drainSizeIn, maxDfu, maxLengthFtByVentSize}",
    "water.minServiceSizeIn, water.minDistributionSizeIn, water.continuousFlowWsfuPerGpm",
    "water.serviceSizing[]: rows of {pressureRange, meterSizeIn, serviceSizeIn, distributionSizeIn, maxWsfuByLengthFt}",
    "waterHeater.expansion.*: whether expansion control is required on a closed system, and the sizing method plus its factors",
    "waterHeater.relief.*: relief valve setting limits and discharge piping rules"
